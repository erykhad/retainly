{
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @retainly/web build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/tatoeba-api/:path*",
      "destination": "https://api.tatoeba.org/:path*"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
