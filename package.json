{
  "name": "retainly",
  "private": true,
  "scripts": {
    "dev:ios": "turbo run ios --filter=@retainly/mobile",
    "dev:web": "turbo run dev --filter=@retainly/web",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "prettier": "^3.1.1",
    "turbo": "^2.9.16"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.5.2"
}
